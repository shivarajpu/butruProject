# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# react-native-firebase v27 resolves Firebase through Swift Package Manager,
# and SPM products are automatic libraries — they are not `.dynamic`. With
# static pod linkage every RNFB pod embeds its own copy of FirebaseCore and
# the app fails to link with duplicate symbols.
#
# Dynamic linkage is the durable fix. Setting USE_FRAMEWORKS=dynamic only for
# one `pod install` would work locally but revert to static on the next run,
# so the line below is unconditional.
use_frameworks! :linkage => :dynamic

target 'butruProject' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26 turns "Explicitly Built Modules" on by default and CocoaPods does
    # not work with it — pod targets fail with, for example,
    #   error: Unable to find module dependency: '_DarwinFoundation3'
    # The app target gets the same setting from Config/Shared.xcconfig; the
    # pods only see build settings set here. Remove once CocoaPods and Xcode's
    # explicit modules are known to coexist.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      end

      # react-native-razorpay 3.0.0 imports both <RazorpayCore/…> and
      # <Razorpay/…>, but CocoaPods only propagates the vendored framework of
      # its direct `razorpay-pod` dependency (RazorpayStandard). Without these
      # flags the pod links with "Undefined symbols: Razorpay.RazorpayCheckout".
      next unless target.name == 'react-native-razorpay'

      target.build_configurations.each do |config|
        other_ldflags = config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
        other_ldflags = [other_ldflags] if other_ldflags.is_a?(String)
        %w[Razorpay RazorpayCore].each do |framework|
          flag = %(-framework "#{framework}")
          other_ldflags << flag unless other_ldflags.include?(flag)
        end
        config.build_settings['OTHER_LDFLAGS'] = other_ldflags
      end
    end
    installer.pods_project.save
  end
end
