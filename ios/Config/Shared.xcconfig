// ═══════════════════════════════════════════════════════════════════════════
//  Shared.xcconfig — committed, hand-editable base layer.
// ═══════════════════════════════════════════════════════════════════════════
//
//  You should almost never edit this per client. Client-specific data belongs
//  in clients/clients.json; run `npm run clients:sync` to regenerate
//  Config/Clients/<id>.xcconfig.
//
//  Include chain actually used by the target (see Config/Debug.xcconfig):
//
//      Shared.xcconfig                 this file — hand-editable
//        → Pods-butruProject.debug.xcconfig   CocoaPods (generated by pod install)
//          → Client.xcconfig                 generated, git-ignored
//             → Clients/<id>.xcconfig       committed, one per client
//
//  Order matters: later includes win. Pods sits in the middle so its settings
//  still override the defaults here, while the client's identity always has the
//  final word.

// ── Deployment ───────────────────────────────────────────────────────────────
IPHONEOS_DEPLOYMENT_TARGET = 15.1
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2

// ── Fallback display name ────────────────────────────────────────────────────
// Every client xcconfig overrides this. It only shows up if a client file is
// missing, and then you want a visible default rather than an empty label.
CLIENT_DISPLAY_NAME = Butru

// ── Warning reduction ────────────────────────────────────────────────────────
// Routine in React Native projects: duplicate-archiver and unused-variable noise
// from third-party pods buries anything worth reading.
GCC_WARN_INHIBIT_ALL_WARNINGS = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = NO

// Client-specific Info.plist path (overridden by client xcconfig)
INFOPLIST_FILE = butruProject/Info.plist
