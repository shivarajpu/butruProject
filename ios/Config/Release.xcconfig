// ═══════════════════════════════════════════════════════════════════════════
//  Release.xcconfig — the target's base configuration for Release.
//
//  Wired up once in butruProject.xcodeproj. You do not need to edit this to add
//  a client: Config/Client.xcconfig and Config/Clients/*.xcconfig are generated
//  from clients/clients.json by `npm run clients:sync`.
//
//  Include order is deliberate — see Config/Shared.xcconfig for the full chain.
// ═══════════════════════════════════════════════════════════════════════════

#include "Shared.xcconfig"

// CocoaPods. Required: without it React Native's headers, libraries and
// linker flags are missing and the build fails. Regenerated by `pod install`.
#include "../Pods/Target Support Files/Pods-butruProject/Pods-butruProject.release.xcconfig"

// The client currently being built. Git-ignored; regenerated on every build.
#include "Client.xcconfig"
