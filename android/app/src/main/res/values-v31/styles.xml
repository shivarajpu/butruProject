<resources>

    <!--
    Android 12+ splash screen. `windowSplashScreenBackground` replaces the old
    windowBackground on the system splash, and the icon is deliberately left
    unset so the launcher-provided icon is used rather than a blank square.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowSplashScreenBackground">@color/brand_launch_background</item>
    </style>

</resources>
