<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand colour used for the window background during the cold-start frames,
  before React Native has mounted and the JS splash can read the storefront
  config's `theme.primaryColor`.

  This is only a floor. The value cannot come from the API because it is
  resolved at install time on a per-tenant basis, while the launch theme is
  baked into the binary. It matches the compiled-in default in
  `src/config/app_config.ts` so the hand-off from the native window to
  `SplashScreen` does not visibly jump on a fresh install.

  ── OVERRIDDEN PER CLIENT ─────────────────────────────────────────────────
  Every build is flavoured, and each flavour source set supplies its own
  `brand_launch_background` in `src/<flavor>/res/values/colors.xml`, generated
  from the client's `splash.background` (or `theme.light.primary`) in
  `clients/clients.json`. That per-flavour value wins over this one.

  So for Butru — whose value is identical — this entry is a no-op, and for every
  other client it is dead. Change the colour in clients/clients.json and run
  `npm run clients:sync`; editing this file will appear to do nothing.
-->
<resources>
    <color name="brand_launch_background">#B12B5B</color>
</resources>
